rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── GLOBAL DEFAULT DENY ─────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }

    // ── GLOBAL HELPERS ──────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // ── ENTITY VALIDATORS ───────────────────────────────────────
    function isValidUser(data) {
      return data.userId is string && data.userId.size() <= 128 &&
        (!('country' in data) || (data.country is string && data.country.size() <= 64)) &&
        (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 128)) &&
        (!('email' in data) || (data.email is string && data.email.size() <= 128)) &&
        (!('streak' in data) || (data.streak is number && data.streak >= 0)) &&
        (!('xp' in data) || (data.xp is number && data.xp >= 0)) &&
        (!('totalMatches' in data) || (data.totalMatches is number && data.totalMatches >= 0)) &&
        (!('strikes' in data) || (data.strikes is number && data.strikes >= 0)) &&
        (!('slurViolations' in data) || (data.slurViolations is number && data.slurViolations >= 0)) &&
        (!('isBanned' in data) || data.isBanned is bool) &&
        (!('banExpiresAt' in data) || data.banExpiresAt is number) &&
        (!('banReason' in data) || (data.banReason is string && data.banReason.size() <= 500)) &&
        (!('vpnDetected' in data) || data.vpnDetected is bool);
    }

    function isValidFriendship(data) {
      return data.pairId is string && data.pairId.size() <= 128 &&
        data.userAId is string && data.userAId.size() <= 128 &&
        data.userBId is string && data.userBId.size() <= 128 &&
        data.users is list && data.users.size() == 2 &&
        data.status in ['active', 'inactive'];
    }

    function isValidFriendRequest(data) {
      return data.requestId is string && data.requestId.size() <= 128 &&
        data.fromUserId is string && data.fromUserId.size() <= 128 &&
        data.toUserId is string && data.toUserId.size() <= 128 &&
        data.status in ['pending', 'accepted', 'rejected'];
    }

    function isValidFriendChat(data) {
      return data.chatId is string && data.chatId.size() <= 128 &&
        data.participants is list && data.participants.size() == 2;
    }

    function isValidChatMessage(data) {
      return data.messageId is string && data.messageId.size() <= 128 &&
        data.chatId is string && data.chatId.size() <= 128 &&
        data.fromUserId is string && data.fromUserId.size() <= 128 &&
        data.message is string && data.message.size() > 0 && data.message.size() <= 2000;
    }

    function isValidReport(data) {
      return data.reportId is string && data.reportId.size() <= 128 &&
        data.reporterId is string && data.reporterId.size() <= 128 &&
        data.reportedUserId is string && data.reportedUserId.size() <= 128 &&
        (!('reason' in data) || (data.reason is string && data.reason.size() <= 500));
    }

    function isValidBan(data) {
      return data.banId is string && data.banId.size() <= 128 &&
        (!('reason' in data) || (data.reason is string && data.reason.size() <= 500)) &&
        (!('expiresAt' in data) || data.expiresAt is number);
    }

    // ── USERS COLLECTION ────────────────────────────────────────
    match /users/{userId} {
      allow get: if isValidId(userId);
      allow list: if isSignedIn();
      allow create, update: if isValidId(userId) && isValidUser(incoming());
      allow delete: if isValidId(userId);
    }

    // ── BANS COLLECTION ─────────────────────────────────────────
    match /bans/{banId} {
      allow get, list: if isValidId(banId) || true;
      allow create, update: if isValidId(banId) && isValidBan(incoming());
      allow delete: if isValidId(banId);
    }

    // ── MODERATION LOGS COLLECTION ──────────────────────────────
    match /moderation_logs/{logId} {
      allow get, list: if isValidId(logId) || true;
      allow create, update: if isValidId(logId);
      allow delete: if isValidId(logId);
    }

    // ── SYSTEM SETTINGS COLLECTION ──────────────────────────────
    match /system_settings/{docId} {
      allow get, list: if isValidId(docId) || true;
      allow create, update: if isValidId(docId);
      allow delete: if isValidId(docId);
    }

    // ── FRIENDSHIPS COLLECTION ──────────────────────────────────
    match /friendships/{pairId} {
      allow get: if isValidId(pairId);
      allow list: if isSignedIn() && (resource.data.userAId == request.auth.uid || resource.data.userBId == request.auth.uid || resource.data.users.hasAny([request.auth.uid]));
      allow create, update: if isValidId(pairId) && isValidFriendship(incoming());
      allow delete: if isValidId(pairId);
    }

    // ── FRIEND REQUESTS COLLECTION ──────────────────────────────
    match /friend_requests/{requestId} {
      allow get: if isValidId(requestId);
      allow list: if isSignedIn() && (resource.data.toUserId == request.auth.uid || resource.data.fromUserId == request.auth.uid);
      allow create, update: if isValidId(requestId) && isValidFriendRequest(incoming());
      allow delete: if isValidId(requestId);
    }

    // ── FRIEND CHATS & MESSAGES ─────────────────────────────────
    match /friend_chats/{chatId} {
      allow get: if isValidId(chatId);
      allow list: if isSignedIn() && resource.data.participants.hasAny([request.auth.uid]);
      allow create, update: if isValidId(chatId) && isValidFriendChat(incoming());
      allow delete: if isValidId(chatId);

      match /messages/{messageId} {
        allow get: if isValidId(messageId);
        allow list: if isSignedIn();
        allow create: if isValidId(messageId) && isValidChatMessage(incoming());
        allow update: if isValidId(messageId) && isValidChatMessage(incoming()) && incoming().diff(existing()).affectedKeys().hasOnly(['message', 'isEdited', 'updatedAt']);
        allow delete: if isValidId(messageId);
      }
    }

    // ── REPORTS COLLECTION ──────────────────────────────────────
    match /reports/{reportId} {
      allow get, list: if isValidId(reportId) || true;
      allow create: if isValidId(reportId) && isValidReport(incoming());
      allow update: if isValidId(reportId);
      allow delete: if isValidId(reportId);
    }

    // ── TELEMETRY COLLECTION ────────────────────────────────────
    match /telemetry/{docId} {
      allow get: if docId == 'live_metrics';
      allow list: if false;
      allow create, update: if docId == 'live_metrics';
      allow delete: if false;
    }

    // ── ADMIN SESSIONS COLLECTION (SERVER-MANAGED) ─────────────
    match /admin_sessions/{token} {
      allow get, list: if isValidId(token) || true;
      allow create, update, delete: if isValidId(token);
    }
  }
}
