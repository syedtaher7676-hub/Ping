{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile, statistics, and moderation state in Ping",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "country": { "type": "string", "maxLength": 64 },
        "displayName": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 128 },
        "totalMatches": { "type": "number" },
        "strikes": { "type": "number" },
        "slurViolations": { "type": "number" },
        "vpnDetected": { "type": "boolean" },
        "vpnDetails": { "type": "object" },
        "isBanned": { "type": "boolean" },
        "banExpiresAt": { "type": "number" },
        "banReason": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" },
        "lastSeenAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "profile": { "type": "object" }
      },
      "required": ["userId"]
    },
    "Friendship": {
      "title": "Friendship",
      "description": "Active friendship between two users identified by canonical pair ID",
      "type": "object",
      "properties": {
        "pairId": { "type": "string", "maxLength": 128 },
        "userAId": { "type": "string", "maxLength": 128 },
        "userBId": { "type": "string", "maxLength": 128 },
        "users": { "type": "array" },
        "status": { "type": "string", "enum": ["active", "inactive"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["pairId", "userAId", "userBId", "users", "status"]
    },
    "FriendRequest": {
      "title": "FriendRequest",
      "description": "Friend request sent from one user to another",
      "type": "object",
      "properties": {
        "requestId": { "type": "string", "maxLength": 128 },
        "fromUserId": { "type": "string", "maxLength": 128 },
        "toUserId": { "type": "string", "maxLength": 128 },
        "roomId": { "type": "string", "maxLength": 128 },
        "status": { "type": "string", "enum": ["pending", "accepted", "rejected"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["requestId", "fromUserId", "toUserId", "status"]
    },
    "FriendChat": {
      "title": "FriendChat",
      "description": "Direct message chat session between friends",
      "type": "object",
      "properties": {
        "chatId": { "type": "string", "maxLength": 128 },
        "participants": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "lastMessage": { "type": "string", "maxLength": 2000 }
      },
      "required": ["chatId", "participants"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Individual message inside a friend chat",
      "type": "object",
      "properties": {
        "messageId": { "type": "string", "maxLength": 128 },
        "chatId": { "type": "string", "maxLength": 128 },
        "fromUserId": { "type": "string", "maxLength": 128 },
        "message": { "type": "string", "maxLength": 2000 },
        "isFlash": { "type": "boolean" },
        "isEdited": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "replyTo": { "type": "object" }
      },
      "required": ["messageId", "chatId", "fromUserId", "message"]
    },
    "Report": {
      "title": "Report",
      "description": "User moderation report",
      "type": "object",
      "properties": {
        "reportId": { "type": "string", "maxLength": 128 },
        "reporterId": { "type": "string", "maxLength": 128 },
        "reportedUserId": { "type": "string", "maxLength": 128 },
        "reason": { "type": "string", "maxLength": 500 },
        "status": { "type": "string", "enum": ["pending", "pending_review", "reviewed", "dismissed"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["reportId", "reporterId", "reportedUserId"]
    },
    "Ban": {
      "title": "Ban",
      "description": "Active and historical hardware device and user suspensions",
      "type": "object",
      "properties": {
        "banId": { "type": "string", "maxLength": 128 },
        "reason": { "type": "string", "maxLength": 500 },
        "expiresAt": { "type": "number" },
        "durationMs": { "type": "number" },
        "bannedAt": { "type": "number" },
        "active": { "type": "boolean" },
        "userId": { "type": "string", "maxLength": 128 },
        "deviceHash": { "type": "string", "maxLength": 128 },
        "ip": { "type": "string", "maxLength": 64 },
        "bannedBy": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["banId", "expiresAt"]
    },
    "ModerationLog": {
      "title": "ModerationLog",
      "description": "Audit record of safety interventions and violation strikes",
      "type": "object",
      "properties": {
        "logId": { "type": "string", "maxLength": 128 },
        "type": { "type": "string", "maxLength": 64 },
        "userId": { "type": "string", "maxLength": 128 },
        "detail": { "type": "string", "maxLength": 1000 },
        "timestamp": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["logId", "type"]
    },
    "SystemSettings": {
      "title": "SystemSettings",
      "description": "Global safety controls, VPN shield, and rate limiters",
      "type": "object",
      "properties": {
        "docId": { "type": "string", "maxLength": 64 },
        "vpnShieldEnabled": { "type": "boolean" },
        "strictEmergencyMode": { "type": "boolean" },
        "slowModeSeconds": { "type": "number" },
        "raidShieldEnabled": { "type": "boolean" },
        "blockExternalLinks": { "type": "boolean" },
        "queueCapLimit": { "type": "number" }
      }
    },
    "Telemetry": {
      "title": "Telemetry",
      "description": "Aggregated anonymous system telemetry metrics",
      "type": "object",
      "properties": {
        "system_summary": { "type": "object" },
        "sentiment_distribution": { "type": "object" },
        "session_durations": { "type": "object" },
        "retention_metrics": { "type": "object" },
        "behavior_analytics": { "type": "object" },
        "telemetry_history": { "type": "array" }
      }
    },
    "AdminSession": {
      "title": "AdminSession",
      "description": "Multi-device persistent admin session tokens with TTL",
      "type": "object",
      "properties": {
        "token": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "number" },
        "expiresAt": { "type": "number" },
        "valid": { "type": "boolean" }
      },
      "required": ["token", "expiresAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles, match statistics, and moderation state"
    },
    "/bans/{banId}": {
      "schema": "Ban",
      "description": "Active hardware device and user suspensions"
    },
    "/moderation_logs/{logId}": {
      "schema": "ModerationLog",
      "description": "Moderation and policy violation logs"
    },
    "/system_settings/{docId}": {
      "schema": "SystemSettings",
      "description": "Global server configuration and safety shields"
    },
    "/friendships/{pairId}": {
      "schema": "Friendship",
      "description": "Canonical friendship records between connected pairs"
    },
    "/friend_requests/{requestId}": {
      "schema": "FriendRequest",
      "description": "Pending and resolved friend requests"
    },
    "/friend_chats/{chatId}": {
      "schema": "FriendChat",
      "description": "Friend chat conversation records"
    },
    "/friend_chats/{chatId}/messages/{messageId}": {
      "schema": "ChatMessage",
      "description": "Persistent chat messages between friends"
    },
    "/reports/{reportId}": {
      "schema": "Report",
      "description": "User moderation and behavior reports"
    },
    "/telemetry/{docId}": {
      "schema": "Telemetry",
      "description": "Aggregated anonymous system telemetry and health metrics"
    },
    "/admin_sessions/{token}": {
      "schema": "AdminSession",
      "description": "Persistent multi-device admin session tokens"
    }
  }
}
